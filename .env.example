# Password tunggal untuk masuk ke app (bebas, ganti dengan PIN/password sendiri)
APP_PASSWORD=

# Gemini API key (fase 1, gratis) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsional, default: gemini-2.0-flash
GEMINI_MODEL=

# Database (kosongkan untuk pakai file lokal ./local.db saat development)
# Isi berikut kalau sudah deploy & pakai Turso (https://turso.tech):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
