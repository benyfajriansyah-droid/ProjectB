# Password tunggal untuk masuk ke app (bebas, ganti dengan PIN/password sendiri)
APP_PASSWORD=

# Gemini API key (fase 1, gratis) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsional, default: gemini-2.0-flash
GEMINI_MODEL=

# Postgres connection string.
# Di Vercel: bikin database lewat tab Storage > Create Database > Neon,
# variabel ini otomatis ke-inject, tidak perlu diisi manual.
# Untuk development lokal, isi dengan connection string dari dashboard Neon.
DATABASE_URL=
